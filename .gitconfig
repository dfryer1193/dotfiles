[core]
	excludesfile = /home/dfryer/.gitignore
[color]
  diff = auto
  ui = auto
[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  ls = log --oneline
  cmt = commit -v
  branch-name = "!git rev-parse --abbrev-ref HEAD"
  fpush = push --force-with-lease
  pushb = "!git push -u origin $(git branch-name)"
	sign = "!f() { git rebase \"$1\" --committer-date-is-author-date --exec 'GIT_COMMITTER_DATE=\"$(git log -1 --format=%cI HEAD)\" git commit --amend --no-edit -S --date=\"$(git log -1 --format=%aI HEAD)\"'; }; f"
[user]
  email = dfryer1193@gmail.com
  name = David Fryer
	signingkey = 335D8B9235329AC9
[init]
	defaultBranch = main
[gpg]
	program = gpg
[commit]
	gpgsign = true
[tag]
	gpgsign = true
